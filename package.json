{
  "name": "pi-fabric",
  "version": "0.82.3",
  "description": "A programmable tool and agent runtime for Pi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build.mjs && bun run assert:build-artifacts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "node scripts/test-dirty.mjs",
    "test:related": "vitest run --related",
    "check:fast": "bun run typecheck && bun run test:changed",
    "certify:context": "bun run build && node scripts/certify-context.mjs",
    "certify:entropy": "bun run build && node scripts/certify-entropy.mjs",
    "benchmark:real-resume": "bun run build && node scripts/benchmark-real-resume.mjs",
    "benchmark:memory-heads": "bun run build && node scripts/benchmark-memory-heads.mjs",
    "lint:dead": "knip --no-gitignore",
    "check": "bun run typecheck && bun run build && bun run assert:lazy-graph && bun run test && bun run lint:dead",
    "assert:lazy-graph": "node scripts/assert-lazy-graph-host-free.mjs",
    "assert:build-artifacts": "node scripts/assert-build-artifacts.mjs",
    "prepack": "bun run check"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "mcp",
    "agents",
    "actors",
    "steering",
    "mesh",
    "swarm",
    "workflows",
    "rlm",
    "orchestration"
  ],
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-fabric.git"
  },
  "homepage": "https://github.com/monotykamary/pi-fabric#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-fabric/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/monotykamary/pi-fabric/main/media/banner.svg"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "mcporter": "^0.12.3",
    "quickjs-emscripten-core": "^0.32.0",
    "shiki": "4.4.3",
    "typebox": "1.3.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": ">=0.80.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "knip": "^6.29.0",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "."
  ],
  "overrides": {
    "ajv": {
      "fast-uri": "^3.1.6"
    }
  }
}
